{
    "name": "adamjmarshall/pr-file-library",
    "description": "A simple shared file-hosting area for Filament v5: authenticated users browse and view files, permitted users upload files and create revocable signed links for unauthenticated sharing.",
    "type": "library",
    "license": "MIT",
    "keywords": ["filament", "laravel", "file-library", "file-sharing"],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "spatie/laravel-permission": "^6.0|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "AdamMarshall\\FilamentFileLibrary\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AdamMarshall\\FilamentFileLibrary\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AdamMarshall\\FilamentFileLibrary\\FilamentFileLibraryServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
